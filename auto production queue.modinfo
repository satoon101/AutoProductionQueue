<?xml version="1.0" encoding="utf-8"?>
<Mod id="c2cc524c-5e59-4633-a660-a226e0a4a0b2" version="1">

    <Properties>
        <Name>Auto Production Queue</Name>
        <Description>Automatically fills each city's production queue when necessary.</Description>
        <Teaser>Sneaky Queue</Teaser>
        <Authors>satoon101</Authors>
        <CompatibleVersions>2.0</CompatibleVersions>
    </Properties>

    <InGameActions>

        <ReplaceUIScript id="CustomActionPanel">
            <Properties>
                <LoadOrder>870</LoadOrder>
                <LuaContext>ActionPanel</LuaContext>
                <LuaReplace>scripts/UI/ActionPanel_PreTurnEnd.lua</LuaReplace>
            </Properties>
        </ReplaceUIScript>

        <AddUserInterfaces id="ProductionQueue">
            <Properties>
                <Context>InGame</Context>
            </Properties>
            <File>scripts/UI/AutoProductionQueue.xml</File>
        </AddUserInterfaces>

        <ImportFiles id="AutoProductionQueueImports">
            <File>scripts/UI/AutoProductionQueue_Config.lua</File>
            <File>scripts/UI/AutoProductionQueue_Constants.lua</File>
            <File>scripts/UI/AutoProductionQueue_Helpers.lua</File>
            <File>scripts/UI/AutoProductionQueue_Managers.lua</File>
        </ImportFiles>

    </InGameActions>

    <Files>
        <File>scripts/UI/ActionPanel_PreTurnEnd.lua</File>
        <File>scripts/UI/AutoProductionQueue_Config.lua</File>
        <File>scripts/UI/AutoProductionQueue_Constants.lua</File>
        <File>scripts/UI/AutoProductionQueue_Helpers.lua</File>
        <File>scripts/UI/AutoProductionQueue_Managers.lua</File>
        <File>scripts/UI/AutoProductionQueue.lua</File>
        <File>scripts/UI/AutoProductionQueue.xml</File>
    </Files>

</Mod>
